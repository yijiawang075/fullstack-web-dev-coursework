### Get all movies
GET http://localhost:3010/movies

### Get one movie
GET http://localhost:3010/movies/1

### Get a missing movie
GET http://localhost:3010/movies/999

### Create a valid movie
POST http://localhost:3010/movies
Content-Type: application/json

{
  "title": "Arrival",
  "year": 2016,
  "genre": "Sci-Fi"
}

### Create an invalid movie
POST http://localhost:3010/movies
Content-Type: application/json

{
  "title": "",
  "year": "not a number"
}

### Replace a movie
PUT http://localhost:3010/movies/1
Content-Type: application/json

{
  "title": "The Matrix",
  "year": 1999,
  "genre": "Sci-Fi"
}

### Invalid incomplete PUT
PUT http://localhost:3010/movies/1
Content-Type: application/json

{
  "title": "The Matrix"
}

### Partially update a movie
PATCH http://localhost:3010/movies/1
Content-Type: application/json

{
  "year": 2000
}

### Filter and sort movies
GET http://localhost:3010/movies?genre=Sci-Fi&minYear=2000&sort=year

### Invalid query parameter
GET http://localhost:3010/movies?minYear=invalid

### Delete a movie
DELETE http://localhost:3010/movies/1

### Delete the same movie again
DELETE http://localhost:3010/movies/1

### Unknown route
GET http://localhost:3010/does-not-exist